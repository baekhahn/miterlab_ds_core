{
  "name": "miterlab-core-design-system",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight, scalable core design system for Miterlab",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "figma:dev": "node scripts/figma-dev.mjs",
    "figma:restart": "bash ./start-figma-local.command",
    "bridge:dev": "npm run dev -w @miterlab/figma-bridge",
    "bridge:build": "npm run build -w @miterlab/figma-bridge",
    "bridge:start": "npm run start -w @miterlab/figma-bridge",
    "docs:dev": "npm run dev -w @miterlab/docs",
    "docs:build": "npm run build -w @miterlab/docs",
    "docs:serve": "npm run serve -w @miterlab/docs",
    "plugin:build": "npm run build -w @miterlab/figma-plugin",
    "plugin:typecheck": "npm run typecheck -w @miterlab/figma-plugin",
    "sync:button-input": "npm run docs:generate -w @miterlab/docs && npm run generate:button-inspection -w @miterlab/figma-generator && npm run generate:input-inspection -w @miterlab/figma-generator && npm run plugin:build",
    "generate:button-inspection": "npm run generate:button-inspection -w @miterlab/figma-generator",
    "generate:input-inspection": "npm run generate:input-inspection -w @miterlab/figma-generator",
    "generate:tabs-inspection": "npm run generate:tabs-inspection -w @miterlab/figma-generator",
    "generate:list-cell-inspection": "npm run generate:list-cell-inspection -w @miterlab/figma-generator",
    "generate:overlay-inspection": "npm run generate:overlay-inspection -w @miterlab/figma-generator",
    "generate:navigation-inspection": "npm run generate:navigation-inspection -w @miterlab/figma-generator",
    "generate:form-inspection": "npm run generate:form-inspection -w @miterlab/figma-generator",
    "generate:core-families": "npm run generate:core-families -w @miterlab/figma-generator",
    "generate:catalog": "npm run generate:catalog -w @miterlab/figma-generator",
    "generate:login": "npm run generate:login -w @miterlab/figma-generator",
    "generate:playground": "npm run generate:playground -w @miterlab/figma-generator",
    "generate:settings": "npm run generate:settings -w @miterlab/figma-generator",
    "generate:dashboard": "npm run generate:dashboard -w @miterlab/figma-generator",
    "generate:filter-list": "npm run generate:filter-list -w @miterlab/figma-generator",
    "execute:button-inspection": "npm run execute:button-inspection -w @miterlab/figma-generator",
    "execute:input-inspection": "npm run execute:input-inspection -w @miterlab/figma-generator",
    "execute:tabs-inspection": "npm run execute:tabs-inspection -w @miterlab/figma-generator",
    "execute:list-cell-inspection": "npm run execute:list-cell-inspection -w @miterlab/figma-generator",
    "execute:overlay-inspection": "npm run execute:overlay-inspection -w @miterlab/figma-generator",
    "execute:navigation-inspection": "npm run execute:navigation-inspection -w @miterlab/figma-generator",
    "execute:form-inspection": "npm run execute:form-inspection -w @miterlab/figma-generator",
    "execute:core-families": "npm run execute:core-families -w @miterlab/figma-generator",
    "execute:catalog": "npm run execute:catalog -w @miterlab/figma-generator",
    "execute:login": "npm run execute:login -w @miterlab/figma-generator",
    "execute:playground": "npm run execute:playground -w @miterlab/figma-generator",
    "execute:settings": "npm run execute:settings -w @miterlab/figma-generator",
    "execute:dashboard": "npm run execute:dashboard -w @miterlab/figma-generator",
    "execute:filter-list": "npm run execute:filter-list -w @miterlab/figma-generator",
    "mcp:probe:readonly": "npm run mcp:probe:readonly -w @miterlab/figma-generator",
    "mcp:probe:writable": "npm run mcp:probe:writable -w @miterlab/figma-generator",
    "wanted:extract": "node packages/ui-core/scripts/wanted/crawlWantedDocs.mjs",
    "wanted:normalize": "node packages/ui-core/scripts/wanted/normalizeWantedDocs.mjs",
    "wanted:parity": "node packages/ui-core/scripts/wanted/compareWantedParity.mjs",
    "wanted:sync": "npm run wanted:extract && npm run wanted:normalize && npm run wanted:parity && npm run generate:catalog"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
