    },
    {
      "type": "stack",
      "name": "action-section",
      "x": 48,
      "y": 228,
      "width": 1320,
      "direction": "vertical",
      "gap": 24,
      "children": [
        {
          "type": "stack",
          "name": "action-row-1",
          "direction": "horizontal",
          "gap": 16,
          "width": 1320,
          "children": [
            {
              "type": "component",
              "name": "Saved toast",
              "component": "toast",
              "props": {
                "content": "Saved successfully",
                "icon": "success",
                "duration": 2000,
                "position": "bottom"
