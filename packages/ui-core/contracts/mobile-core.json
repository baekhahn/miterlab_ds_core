        "disabled": { "fill": "#F4F4F5", "stroke": "#E1E2E4", "text": "#989BA2", "subtle": "#989BA2" },
        "readonly": { "fill": "#F7F7F8", "stroke": "#E1E2E4", "text": "#2E2F33", "subtle": "#989BA2" },
        "loading": { "fill": "#FFFFFF", "stroke": "#E1E2E4", "text": "#989BA2", "subtle": "#989BA2" }
