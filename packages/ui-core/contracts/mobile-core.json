        "default": { "fill": "#FFFFFF", "stroke": "#E1E2E4", "text": "#171719", "subtle": "#989BA2" },
        "error": { "fill": "#FFFFFF", "stroke": "#FF4242", "text": "#171719", "subtle": "#989BA2" },
